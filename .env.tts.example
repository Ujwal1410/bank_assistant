# ── TTS GPU box only (8 GB machine) ─────────────────────────────────────────────
# Copy to .env on the Parler GPU machine.
#
# Setup:
#   powershell -ExecutionPolicy Bypass -File .\scripts\setup_tts_box.ps1
#   Edit BANK_TTS_REMOTE_KEY below — must match kiosk .env exactly
#
# Run:
#   powershell -ExecutionPolicy Bypass -File .\scripts\run_tts_server.ps1
#   cloudflared tunnel (see deploy/cloudflare/config-tts.yml.example)
#
# Do NOT set BANK_TTS_REMOTE_URL here (TTS server would call itself).

# ── Parler engine ──────────────────────────────────────────────────────────────
BANK_TTS_ENGINE=parler
BANK_TTS_SPEAKER=Suresh
BANK_TTS_ALLOW_MMS=0
BANK_PIPELINE_WORKER=0

# ── GPU / speed tuning ─────────────────────────────────────────────────────────
BANK_PARLER_DTYPE=fp16
BANK_PARLER_REQUIRE_CUDA=1
BANK_PARLER_DEVICE=cuda:0
BANK_PARLER_ATTN_IMPLEMENTATION=sdpa
# "default" / torch.compile needs Triton (often missing on Windows) — keep eager.
BANK_PARLER_COMPILE=0
# Sampling required for full Kannada sentences (greedy often = 1 word / silence)
BANK_PARLER_DO_SAMPLE=1
BANK_TTS_CACHE_MAX=512
BANK_TTS_CONCURRENCY=1
BANK_TTS_QUEUE_TIMEOUT=5

# Dynamic audio token budget (leave as-is unless TTS box owner changes them):
BANK_PARLER_MAX_NEW_TOKENS=1500
BANK_PARLER_MIN_NEW_TOKENS=280
BANK_PARLER_TOKENS_PER_CHAR=40
# Keep TTS process running; kiosk waits on /api/health ready=true before demos.

BANK_PARLER_TEMPERATURE=0.9

# ── API auth (kiosk sends X-Bank-Tts-Key header) ───────────────────────────────
BANK_TTS_REMOTE_KEY=CHANGE_ME-must-match-kiosk

# ── Server port (default 8001) ─────────────────────────────────────────────────
# BANK_TTS_PORT=8001

# ── HuggingFace (first download only) ──────────────────────────────────────────
# Use 0 during setup_tts_box.ps1 model download; switch to 1 after models cached.
TRANSFORMERS_OFFLINE=0
HF_HUB_OFFLINE=0
HF_DATASETS_OFFLINE=0
