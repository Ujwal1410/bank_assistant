# Frontend — copy to frontend/.env.local (optional; dev works without this file)
#
# ── Dev (default) ─────────────────────────────────────────────────────────────
# Leave VITE_API_BASE empty — Vite proxies /api → http://127.0.0.1:8000
# VITE_API_BASE=
#
# ── LAN demo (phone/tablet on same Wi‑Fi) ───────────────────────────────────────
# Point API at kiosk PC IP (HTTPS if using dev certs):
# VITE_API_BASE=https://192.168.1.22:8000
#
# ── Cloudflare tunnel (public agent + admin) ───────────────────────────────────
# Copy frontend/.env.cloudflare.example instead, or set:
# VITE_AGENT_URL=https://agent.sarastralabs.com
#
# When tunnel routes /api directly to :8000 (scripts/ensure-tunnel-config.ps1),
# keep VITE_API_BASE empty — same-origin /api still works.
#
# Production static build (scripts/run-kiosk-prod.ps1): same — proxy handles /api.
#
# ── Optional direct API subdomain (advanced) ─────────────────────────────────
# If you expose api.sarastralabs.com → :8000 in Cloudflare:
# VITE_API_BASE=https://api.sarastralabs.com
