# Cloudflare tunnel — copy to frontend/.env.local
#
# Prereqs on kiosk PC:
#   scripts/start-kiosk-api.ps1          →  :8000
#   frontend npm run dev:all             →  :5173 / :5174  (or run-kiosk-prod.ps1)
#   scripts/run-kiosk-tunnel.ps1         →  agent/admin.sarastralabs.com
#
# Tunnel should route /api → :8000 directly (scripts/ensure-tunnel-config.ps1).
# Leave VITE_API_BASE empty so the browser uses same-origin /api on each hostname.

VITE_AGENT_URL=https://agent.sarastralabs.com

# VITE_API_BASE=
