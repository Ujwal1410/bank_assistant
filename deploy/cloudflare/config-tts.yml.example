# Cloudflare tunnel — TTS GPU box (Parler :8001)
# Copy to:  %USERPROFILE%\.cloudflared\config-tts.yml
# Replace <TUNNEL-UUID> and <YOUR-USER> with your values.

tunnel: bank-tts
credentials-file: C:\Users\<YOUR-USER>\.cloudflared\<TUNNEL-UUID>.json

ingress:
  - hostname: tts.sarastralabs.com
    service: http://127.0.0.1:8001
  - service: http_status:404
